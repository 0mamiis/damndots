# Copy to .env. Start-Dots.cmd / npm start read it; keep .env private.
DOTS_HOST=127.0.0.1
DOTS_PORT=9340
DOTS_APPSERVER_URL=ws://127.0.0.1:9912
DOTS_APPSERVER_LISTEN=ws://127.0.0.1:9912

# Initial provider. Once running, configure custom providers in the dashboard.
DOTS_MODEL_BASE=http://127.0.0.1:10100/v1
DOTS_MODEL=gpt-6.1-sol
DOTS_REASONING_EFFORT=medium
# DOTS_MODEL_API_KEY=your-provider-key
# Fast / priority is optional; enable only for a model/provider that supports it.
# DOTS_SERVICE_TIER=priority

DOTS_SERVER_URL=http://127.0.0.1:9340
DOTS_CLIENT_PORT=8002
DOTS_NATIVE_PORT=8000
DOTS_DASHBOARD_PORT=4320
DOTS_DASHBOARD_HOST=127.0.0.1
DOTS_COMPUTER_MODE=pc
# Connection profiles and PC/Linux selection are managed in Dashboard > Sunucular.
# Custom WSL rootfs installation uses a local file path + SHA256 from that screen.
# Optional comma-separated dashboard backend origins; remote origins need HTTPS.
# DOTS_ALLOWED_SERVERS=https://dots.example.com
# DOTS_CODEX_CLI=/path/to/codex
# DOTS_DATA_DIR=/private/dots-data
# DOTS_TLS_CERT=/private/server-chain.pem
# DOTS_TLS_KEY=/private/server.key

# Optional, explicitly installed Codex chat bridges; default endpoints are loopback.
# DOTS_MAIN_CODEX_URL=ws://127.0.0.1:9913
# DOTS_MAIN_CODEX_TOKEN_FILE=/private/main-bridge-token
# DOTS_MAIN_CODEX_DISABLE=1
# DOTS_LOCAL_CODEX_URL=http://127.0.0.1:9914
# DOTS_LOCAL_CODEX_TOKEN_FILE=/private/local-bridge-token
# DOTS_LOCAL_CODEX_DISABLE=1
